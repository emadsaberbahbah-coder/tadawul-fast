diff --git a/tests/test_eodhd_http402_guard.py b/tests/test_eodhd_http402_guard.py
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/tests/test_eodhd_http402_guard.py
@@ -0,0 +1,86 @@
+"""Regression tests for the EODHD HTTP 402 plan-restriction circuit."""
+
+from __future__ import annotations
+
+import asyncio
+
+from core.providers import eodhd_provider as eodhd
+
+
+def test_http_402_classifies_as_plan_restricted() -> None:
+    assert eodhd.EODHDClient._classify_error("HTTP 402 plan_restricted") == "PlanRestricted"
+    assert eodhd.EODHDClient._classify_error("payment_required") == "PlanRestricted"
+
+
+def test_http_402_emits_provider_unhealthy_marker() -> None:
+    assert eodhd._err_indicates_provider_unhealthy("HTTP 402 plan_restricted") is True
+
+
+def test_repeated_plan_restrictions_open_circuit(monkeypatch) -> None:
+    monkeypatch.setenv("EODHD_CIRCUIT_BREAKER_ENABLE", "1")
+    monkeypatch.setenv("EODHD_CIRCUIT_AUTH_THRESHOLD", "2")
+
+    async def scenario() -> None:
+        health = eodhd._ProviderHealth()
+        await health.record_failure("PlanRestricted")
+        first = await health.snapshot()
+        assert first["circuit_state"] == "closed"
+        assert first["consecutive_plan_restrictions"] == 1
+
+        await health.record_failure("PlanRestricted")
+        second = await health.snapshot()
+        assert second["circuit_state"] == "open"
+        assert second["consecutive_plan_restrictions"] == 2
+        assert second["session_stats"]["plan_restricted_count"] == 2
+
+    asyncio.run(scenario())
+
+
+def test_request_json_treats_402_as_terminal_and_does_not_retry(monkeypatch) -> None:
+    monkeypatch.setenv("EODHD_RATE_LIMIT_RPS", "0")
+    monkeypatch.setenv("EODHD_RETRY_ATTEMPTS", "4")
+    monkeypatch.setenv("EODHD_CIRCUIT_AUTH_THRESHOLD", "8")
+    eodhd._HEALTH = None
+
+    class Response402:
+        status_code = 402
+        headers = {}
+        text = "This endpoint is not available under the current plan"
+        content = b"{}"
+
+    async def scenario() -> None:
+        client = eodhd.EODHDClient()
+        client.api_key = "test-token"
+        calls = 0
+
+        async def fake_get(*_args, **_kwargs):
+            nonlocal calls
+            calls += 1
+            return Response402()
+
+        client._client.get = fake_get  # type: ignore[method-assign]
+        try:
+            data, err = await client._request_json("fundamentals/AAPL.US")
+            assert data is None
+            assert err is not None and "HTTP 402 plan_restricted" in err
+            assert calls == 1, "HTTP 402 must never consume the configured retry loop"
+
+            health = await eodhd._get_health()
+            snap = await health.snapshot()
+            assert snap["consecutive_plan_restrictions"] == 1
+            assert snap["session_stats"]["plan_restricted_count"] == 1
+        finally:
+            await client._client.aclose()
+
+    asyncio.run(scenario())
