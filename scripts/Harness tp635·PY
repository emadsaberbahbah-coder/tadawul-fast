import sys, os, importlib.util, pickle, threading, types
from unittest.mock import MagicMock
sys.path.insert(0,"/home/claude/repo/tadawul-fast-main")
def load(path,name):
    spec=importlib.util.spec_from_file_location(name,path); m=importlib.util.module_from_spec(spec); sys.modules[name]=m
    try: spec.loader.exec_module(m)
    except ModuleNotFoundError as e:
        missing=str(e).split("'")[1]; mm=MagicMock(); mm.__name__=missing; sys.modules[missing]=mm; return load(path,name)
    return m
for k in ("TRACK_MAX_RECORDS","TRACK_DEDUP_KEYS"): os.environ.pop(k,None)
hdr,rows=pickle.load(open("/home/claude/perf_log.pkl","rb"))
DATA=[[("" if v is None else v) for v in r] for r in rows[4:] if r and r[0] not in (None,"")]   # 38,040 real records
class WS:  # recorder double for the EXTERNAL gspread worksheet (real data inside)
    def __init__(s,data,row_count): s.data=data; s.row_count=row_count; s.cleared=[]; s.updates=[]
    def get(s,rng):
        import re; m=re.match(r"[A-Z]+(\d+):[A-Z]+(\d+)",rng); r0,r1=int(m.group(1)),int(m.group(2))
        assert r1<=s.row_count, f"range {rng} exceeds grid {s.row_count}"
        lo=r0-6; hi=r1-6+1; return [list(r) for r in s.data[lo:hi]]
    def batch_clear(s,rngs): s.cleared+=rngs
    def update(s,values=None,range_name=None): s.updates.append((range_name,len(values)))
class Backoff:
    def execute_sync(s,fn): return fn()
def make(M,ws):
    st=M.PerformanceStore.__new__(M.PerformanceStore); st.ws=ws; st.backoff=Backoff(); st.cache={}; st.cache_lock=threading.Lock(); return st
def sample_ws(): return WS(DATA,row_count=38045)
# --- control: v6.34.0 loads 10,000 and would clear to row 10,000 ---
M0=load("/home/claude/tp634.py","tp634"); s0=make(M0,sample_ws()); r0=s0.load_records(10000)
assert len(r0)==10000, len(r0)
s0.save_records(r0); assert s0.ws.cleared[0].endswith("10000"), s0.ws.cleared
print("T0 CONTROL v6.34.0: loaded 10,000 of 38,040; clear range",s0.ws.cleared[0],"-> the 28,040 newer records are invisible (defect reproduced)")
# --- v6.35.0 ---
M=load("/home/claude/tp635.py","tp635"); assert M.SCRIPT_VERSION=="6.35.0"
s=make(M,sample_ws()); recs=s.load_records(M._track_max_records_default())
assert len(recs)==38040, len(recs)
dups=[r for r in recs if r.outcome=="DUPLICATE_KEY"]; act=[r for r in recs if r.status==M.PerformanceStatus.ACTIVE]
keys=[r.key for r in recs if r.status==M.PerformanceStatus.ACTIVE]; assert len(keys)==len(set(keys)), "active keys not unique after dedup"
print(f"T1 PASS v6.35.0 loads all {len(recs):,} records; window clamped to grid ({s.ws.row_count}); active after dedup {len(act):,}; duplicates expired {len(dups):,} (all EXPIRED/DUPLICATE_KEY/realized None)")
assert all(r.status==M.PerformanceStatus.EXPIRED and r.realized_roi is None for r in dups)
assert M._LAST_LOAD_STATS=={"loaded":38040,"extent":38045,"dup_expired":len(dups)}, M._LAST_LOAD_STATS
# save: clear to extent, chunked writes covering every row
s.save_records(recs)
assert s.ws.cleared==["A6:AF38045"], s.ws.cleared
tot=sum(n for _,n in s.ws.updates); assert tot==38040 and len(s.ws.updates)==8 and s.ws.updates[0][0]=="A6:AF5005" and s.ws.updates[-1][0]=="A35006:AF38045", (tot,s.ws.updates[:2],s.ws.updates[-1])
print("T2 PASS save: clear",s.ws.cleared[0],"| 8 chunked writes covering 38,040 rows, first",s.ws.updates[0][0],"last",s.ws.updates[-1][0])
# overdue rows are now IN the working set (they can be priced and matured on the next run)
import datetime as dt
overdue=[r for r in act if r.target_date and r.target_date.date()<dt.date(2026,8,31)]
print(f"T3 PASS {len(overdue):,} overdue ACTIVE cohorts are now loaded (v6.34.0 loaded 0 of them: {sum(1 for r in r0 if r.status==M0.PerformanceStatus.ACTIVE and r.target_date and r.target_date.date()<dt.date(2026,8,31))})")
# kill-switch: dedup off keeps duplicates active
os.environ["TRACK_DEDUP_KEYS"]="0"; s2=make(M,sample_ws()); r2=s2.load_records(200000); os.environ.pop("TRACK_DEDUP_KEYS")
assert len(r2)==38040 and not [r for r in r2 if r.outcome=="DUPLICATE_KEY"]
print("T4 PASS TRACK_DEDUP_KEYS=0: 38,040 loaded, no duplicate expiry (v6.34.0 dedup behaviour)")
# small grid never exceeds limits
s3=make(M,WS(DATA[:100],row_count=105)); r3=s3.load_records(200000); assert len(r3)==100; s3.save_records(r3); assert s3.ws.cleared==["A6:AF105"]
print("T5 PASS grid clamp: 105-row sheet -> read/clear ranges end at row 105")
# env override respected
os.environ["TRACK_MAX_RECORDS"]="50"; assert M._track_max_records_default()==50; os.environ.pop("TRACK_MAX_RECORDS"); assert M._track_max_records_default()==200000
print("T6 PASS TRACK_MAX_RECORDS env honoured; default 200,000")
print("PASS 6/6 — real track_performance v6.35.0 store on the real 38,040-record Performance_Log")
